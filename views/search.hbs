<div class="search-page">
  <div class="search-shell">
    <header class="search-hero">
      <p class="home-featured-eyebrow">Search</p>
      <h1 class="search-title">Results for "<span id="search-query">{{query}}</span>"</h1>
      <p class="search-subtitle">Filter by rating, then jump into a place or review that matches your craving.</p>
    </header>

    <div class="search-toolbar">
      <label for="rating-filter">Minimum rating</label>
      <select id="rating-filter">
        <option value="all">All ratings</option>
        <option value="4.5">4.5 and up</option>
        <option value="4.0">4.0 and up</option>
        <option value="3.5">3.5 and up</option>
      </select>
    </div>

    <section id="establishment-results" class="search-section" aria-labelledby="establishment-results-heading">
      <div class="search-section__head">
        <h2 id="establishment-results-heading">Establishments</h2>
      </div>
      <div class="search-result-grid">
        {{#each establishments}}
        <article class="search-result-card">
          <a href="/establishments/{{_id}}" class="search-result-card__title">{{name}}</a>
          <div class="search-result-card__meta">
            <i data-lucide="star" class="w-4 h-4 text-yellow-500 fill-yellow-500 flex-shrink-0" aria-hidden="true"></i>
            <span>{{rating}} ({{reviewsCount}} reviews)</span>
          </div>
          <p>{{description}}</p>
        </article>
        {{else}}
        <div class="empty-state">No establishments matched this search.</div>
        {{/each}}
      </div>
    </section>

    <section id="review-results" class="search-section" aria-labelledby="review-results-heading">
      <div class="search-section__head">
        <h2 id="review-results-heading">Reviews</h2>
      </div>
      <div class="search-result-grid">
        {{#each reviews}}
        <article class="search-result-card">
          <h3 class="search-result-card__title">{{establishment.name}}</h3>
          {{#if title}}<p class="search-result-card__kicker">{{title}}</p>{{/if}}
          <div class="search-result-card__meta">
            <i data-lucide="star" class="w-4 h-4 text-yellow-500 fill-yellow-500 flex-shrink-0" aria-hidden="true"></i>
            <span>{{rating}}</span>
          </div>
          <p>{{comment}}</p>
          <p class="search-result-card__author">By {{user.username}}</p>
        </article>
        {{else}}
        <div class="empty-state">No reviews matched this search.</div>
        {{/each}}
      </div>
    </section>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const query = {{{safeJson query}}};
    const ratingFilter = document.getElementById('rating-filter');
    const establishments = {{{safeJson establishments}}};
    const reviews = {{{safeJson reviews}}};
    ratingFilter.addEventListener('change', () => filterResults(query));

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, function (char) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char];
      });
    }

    function starRowHtml(rating) {
      const r = Number(rating) || 0;
      return Array.from({ length: 5 }, (_, i) => {
        const filled = r >= i + 1;
        const cls = filled ? 'text-yellow-500 fill-yellow-500' : 'text-gray-300';
        return `<i data-lucide="star" class="w-4 h-4 inline-block ${cls}" aria-hidden="true"></i>`;
      }).join('');
    }

    function emptyHtml(message) {
      return `<div class="empty-state">${escapeHtml(message)}</div>`;
    }

    function updateResults(containerId, data, isReview) {
      const section = document.getElementById(containerId);
      const grid = section.querySelector('.search-result-grid');
      grid.innerHTML = '';

      if (!data.length) {
        grid.innerHTML = emptyHtml(isReview ? 'No reviews matched this filter.' : 'No establishments matched this filter.');
        return;
      }

      data.forEach(item => {
        const card = document.createElement('article');
        card.className = 'search-result-card';
        const estHref = item._id ? `/establishments/${item._id}` : '#';
        if (isReview) {
          card.innerHTML = `
            <h3 class="search-result-card__title">${escapeHtml(item.establishment && item.establishment.name)}</h3>
            ${item.title ? `<p class="search-result-card__kicker">${escapeHtml(item.title)}</p>` : ''}
            <div class="search-result-card__meta">${starRowHtml(item.rating)}<span>${escapeHtml(item.rating)}</span></div>
            <p>${escapeHtml(item.comment)}</p>
            <p class="search-result-card__author">By ${escapeHtml(item.user && item.user.username)}</p>
          `;
        } else {
          card.innerHTML = `
            <a href="${estHref}" class="search-result-card__title">${escapeHtml(item.name)}</a>
            <div class="search-result-card__meta">${starRowHtml(item.rating)}<span>${escapeHtml(item.rating)} (${escapeHtml(item.reviewsCount)} reviews)</span></div>
            <p>${escapeHtml(item.description)}</p>
          `;
        }
        grid.appendChild(card);
      });

      if (typeof window.refreshLucideIcons === 'function') {
        window.refreshLucideIcons();
      }
    }

    function filterResults(query) {
      const ratingFilterValue = parseFloat(ratingFilter.value) || 0;
      const lowerCaseQuery = query.toLowerCase();
      const filteredEstablishments = establishments.filter(establishment => {
        const name = String(establishment.name || '').toLowerCase();
        const description = String(establishment.description || '').toLowerCase();
        return (name.includes(lowerCaseQuery) ||
                description.includes(lowerCaseQuery)) &&
               (ratingFilterValue === 0 || establishment.rating >= ratingFilterValue);
      });
      const filteredReviews = reviews.filter(review => {
        const comment = String(review.comment || '').toLowerCase();
        const establishmentName = String(review.establishment && review.establishment.name || '').toLowerCase();
        return comment.includes(lowerCaseQuery) ||
               establishmentName.includes(lowerCaseQuery);
      });
      updateResults('establishment-results', filteredEstablishments, false);
      updateResults('review-results', filteredReviews, true);
    }
  });
</script>
