<div class="explore-page">
    <header class="explore-intro">
        <div>
            <p class="page-establishments-eyebrow">Your campus food map</p>
            <h1>Explore Taft</h1>
            <p>Filter {{resultCount}} community-mapped food places, compare options, and see exactly where to go.</p>
        </div>
        <div class="establishments-mobile-switch" role="group" aria-label="Choose list or map view">
            <button type="button" class="is-active" data-establishments-view="list"><i data-lucide="list" aria-hidden="true"></i>List</button>
            <button type="button" data-establishments-view="map"><i data-lucide="map" aria-hidden="true"></i>Map</button>
        </div>
    </header>

    <form action="/establishments" method="GET" class="explore-filter-bar">
        <div class="explore-filter-bar__label"><i data-lucide="sliders-horizontal" aria-hidden="true"></i><div><strong>Filter places</strong><span>Find a better match</span></div></div>
        <label for="filter-rating">Minimum rating
            <select id="filter-rating" name="rating">
                <option value="all" {{#if (eq selectedRating "all")}}selected{{/if}}>Any rating</option>
                <option value="4.5" {{#if (eq selectedRating "4.5")}}selected{{/if}}>4.5 &amp; up</option>
                <option value="4.0" {{#if (eq selectedRating "4.0")}}selected{{/if}}>4.0 &amp; up</option>
                <option value="3.5" {{#if (eq selectedRating "3.5")}}selected{{/if}}>3.5 &amp; up</option>
            </select>
        </label>
        <label for="filter-category">Category
            <select id="filter-category" name="category">
                <option value="all" {{#if (eq selectedCategory "all")}}selected{{/if}}>All categories</option>
                <option value="Restaurant" {{#if (eq selectedCategory "Restaurant")}}selected{{/if}}>Restaurant</option>
                <option value="Cafe" {{#if (eq selectedCategory "Cafe")}}selected{{/if}}>Café</option>
                <option value="Stall" {{#if (eq selectedCategory "Stall")}}selected{{/if}}>Stall</option>
                <option value="Fastfood" {{#if (eq selectedCategory "Fastfood")}}selected{{/if}}>Fast food</option>
                <option value="Foodcourt" {{#if (eq selectedCategory "Foodcourt")}}selected{{/if}}>Food court</option>
                <option value="Dessert" {{#if (eq selectedCategory "Dessert")}}selected{{/if}}>Dessert</option>
            </select>
        </label>
        <div class="explore-filter-bar__actions">
            <a href="/establishments">Reset</a>
            <button type="submit">Apply filters</button>
        </div>
    </form>

    <div class="explore-layout" id="establishments-layout-grid">
        <section class="explore-results" aria-labelledby="list-heading" data-establishments-panel="list">
            <div class="explore-panel-heading">
                <div><h2 id="list-heading">Places</h2><p>Hover a card to locate its pin.</p></div>
                <span>{{resultCount}} results</span>
            </div>
            <div class="explore-card-list">
                {{#each establishments}}
                <article class="explore-place-card" data-establishment-card data-establishment-id="{{_id}}">
                    <a href="/establishments/{{_id}}" class="explore-place-card__media" aria-label="View {{name}}">
                        <img src="{{mainImage}}" alt="{{#if coverPhotoSource}}Community cover photo of {{name}}{{else}}{{#if (eq mapillaryMatchType 'nearby')}}Nearby Mapillary street view near {{name}}{{else}}{{name}}{{/if}}{{/if}}" data-establishment-img data-establishment-id="{{_id}}">
                        {{#if category}}<span class="explore-place-card__category">{{category}}</span>{{/if}}
                        {{#if coverPhotoSource}}<span class="community-photo-label"><i data-lucide="badge-check" aria-hidden="true"></i>{{#if (eq coverPhotoSource "owner")}}Owner photo{{else}}Community cover{{/if}}</span>{{else}}{{#if (eq mapillaryMatchType "nearby")}}<span class="mapillary-photo-label"><i data-lucide="camera" aria-hidden="true"></i>Nearby street view</span>{{/if}}{{/if}}
                    </a>
                    {{#if ../user}}
                    <button type="button" class="favorite-button favorite-button--card {{#if isFavorite}}is-favorite{{/if}}" data-favorite-button data-establishment-id="{{_id}}" data-place-name="{{name}}" aria-pressed="{{#if isFavorite}}true{{else}}false{{/if}}" aria-label="{{#if isFavorite}}Remove {{name}} from favorites{{else}}Save {{name}} to favorites{{/if}}">
                        <i data-lucide="heart" aria-hidden="true"></i>
                    </button>
                    {{else}}
                    <a href="/login" class="favorite-button favorite-button--card" aria-label="Sign in to save {{name}}" title="Sign in to save">
                        <i data-lucide="heart" aria-hidden="true"></i>
                    </a>
                    {{/if}}
                    <div class="explore-place-card__body">
                        <div class="explore-place-card__meta"><span><i data-lucide="star" aria-hidden="true"></i>{{rating}}</span><span>{{reviewsCount}} reviews</span></div>
                        <h3><a href="/establishments/{{_id}}">{{name}}</a></h3>
                        <p>{{description}}</p>
                        <div class="explore-place-card__footer">
                            {{#if phone}}<span><i data-lucide="phone" aria-hidden="true"></i>{{phone}}</span>{{else}}<span>Taft, Manila</span>{{/if}}
                            <a href="/establishments/{{_id}}"><strong>View place <i data-lucide="arrow-up-right" aria-hidden="true"></i></strong></a>
                        </div>
                    </div>
                </article>
                {{else}}
                <div class="modern-empty-state"><h3>No matches yet</h3><p>Try loosening your filters or reset the list.</p><a href="/establishments">Reset filters</a></div>
                {{/each}}
            </div>
        </section>

        <aside class="explore-map-panel" aria-labelledby="map-heading" data-establishments-panel="map">
            <div class="explore-panel-heading">
                <div><h2 id="map-heading">Map</h2><p>Pins follow your filters.</p></div>
            </div>
            <div id="establishments-map" class="establishments-map-in-grid" role="application" aria-label="Establishments map"></div>
            <script type="application/json" id="establishments-geo-json">{{{establishmentsGeoJson}}}</script>
        </aside>
    </div>

    <p class="explore-data-attribution">Establishment data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a> · Street-level imagery © <a href="https://www.mapillary.com/" target="_blank" rel="noopener noreferrer">Mapillary</a></p>
</div>

<script src="/js/establishments-map.js"></script>
<script src="/js/establishment-images-from-geo-api.js"></script>
<script src="/js/establishments-view-toggle.js"></script>
