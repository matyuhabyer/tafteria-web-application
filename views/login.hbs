<div class="auth-page">
    <section class="auth-card" aria-labelledby="login-title">
        <div class="auth-card__header">
            <p class="auth-eyebrow">Welcome back</p>
            <h1 id="login-title" class="auth-title">Log in to Tafteria</h1>
            <p class="auth-subtitle">Keep track of your favorite Taft spots and share reviews with classmates.</p>
        </div>

        <form action="/login" method="POST" class="auth-form">
            <div class="form-field">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" autocomplete="username" required>
            </div>
            <div class="form-field">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <label class="auth-check" for="remember">
                <input id="remember" type="checkbox" name="remember">
                <span>Remember login</span>
            </label>
            <button type="submit" class="btn-modern btn-modern--primary">Log in</button>
            <p class="auth-switch">
                Need an account?
                <a href="/register">Create one</a>
            </p>
        </form>
    </section>
</div>
