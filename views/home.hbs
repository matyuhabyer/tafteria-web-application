<section class="discovery-hero">
    <div class="discovery-hero__glow" aria-hidden="true"></div>
    <div class="discovery-hero__inner">
        <div class="discovery-hero__copy">
            <p class="hero-eyebrow">The student food guide for Taft</p>
            <h1>What are you craving <em>around Taft?</em></h1>
            <p>Find honest student reviews, campus favorites, and quick bites worth the walk.</p>
            <form action="/search" method="GET" class="discovery-search">
                <i data-lucide="search" aria-hidden="true"></i>
                <label class="sr-only" for="home-search">Search food spots</label>
                <input id="home-search" type="search" name="q" autocomplete="off" placeholder="Chicken, coffee, silog, milk tea…">
                <button type="submit">Find a spot</button>
            </form>
            <div class="craving-chips" aria-label="Popular filters">
                <a href="/establishments?category=Cafe"><i data-lucide="coffee" aria-hidden="true"></i>Cafés</a>
                <a href="/establishments?category=Fastfood"><i data-lucide="utensils" aria-hidden="true"></i>Quick bites</a>
                <a href="/establishments?category=Restaurant"><i data-lucide="soup" aria-hidden="true"></i>Restaurants</a>
                <a href="/establishments?rating=4.5"><i data-lucide="sparkles" aria-hidden="true"></i>Top rated</a>
            </div>
        </div>
        <aside class="campus-pulse" aria-label="Tafteria community overview">
            {{#if heroCarousel.[0]}}
            <a class="campus-pulse__feature" href="/establishments/{{heroCarousel.[0]._id}}">
                <img src="{{heroCarousel.[0].mainImage}}" alt="{{heroCarousel.[0].name}}">
                <div class="campus-pulse__overlay">
                    <span>{{heroCarousel.[0].category}}</span><h2>{{heroCarousel.[0].name}}</h2>
                    <p><i data-lucide="star" aria-hidden="true"></i>{{heroCarousel.[0].rating}} · {{heroCarousel.[0].reviewsCount}} reviews</p>
                </div>
            </a>
            {{/if}}
            <div class="campus-pulse__stats">
                <div><strong>{{establishmentCount}}</strong><span>places mapped</span></div>
                <div><strong>{{reviewCount}}</strong><span>community reviews</span></div>
            </div>
        </aside>
    </div>
</section>

<section class="modern-section" aria-labelledby="trending-title">
    <div class="section-heading-row">
        <div><p class="section-kicker">Discover nearby</p><h2 id="trending-title">Trending around campus</h2><p>Start with places students are already talking about.</p></div>
        <a class="text-link" href="/establishments">See all places <i data-lucide="arrow-right" aria-hidden="true"></i></a>
    </div>
    <div class="place-card-grid">
        {{#each featuredEstablishments}}
        <a href="/establishments/{{_id}}" class="modern-place-card" data-establishment-card data-establishment-id="{{_id}}">
            <div class="modern-place-card__media">
                <img src="{{mainImage}}" alt="{{#if coverPhotoSource}}Community cover photo of {{name}}{{else}}{{#if (eq mapillaryMatchType 'nearby')}}Nearby Mapillary street view near {{name}}{{else}}{{name}}{{/if}}{{/if}}" data-establishment-img data-establishment-id="{{_id}}">
                {{#if category}}<span class="modern-place-card__category">{{category}}</span>{{/if}}
                <span class="modern-place-card__rating"><i data-lucide="star" aria-hidden="true"></i>{{rating}}</span>
                {{#if coverPhotoSource}}<span class="community-photo-label"><i data-lucide="badge-check" aria-hidden="true"></i>{{#if (eq coverPhotoSource "owner")}}Owner photo{{else}}Community cover{{/if}}</span>{{else}}{{#if (eq mapillaryMatchType "nearby")}}<span class="mapillary-photo-label"><i data-lucide="camera" aria-hidden="true"></i>Nearby street view</span>{{/if}}{{/if}}
            </div>
            <div class="modern-place-card__body">
                <h3>{{name}}</h3><p>{{description}}</p>
                <div><span>{{reviewsCount}} reviews</span><span>View place <i data-lucide="arrow-up-right" aria-hidden="true"></i></span></div>
            </div>
        </a>
        {{else}}<div class="modern-empty-state">No places have been added yet.</div>{{/each}}
    </div>
    <p class="mapillary-grid-attribution">Street-level imagery © <a href="https://www.mapillary.com/" target="_blank" rel="noopener noreferrer">Mapillary</a></p>
</section>

<section class="modern-section modern-section--reviews" aria-labelledby="reviews-title">
    <div class="section-heading-row">
        <div><p class="section-kicker">Fresh takes</p><h2 id="reviews-title">What students are saying</h2></div>
        <a class="text-link" href="/register">Join the community <i data-lucide="arrow-right" aria-hidden="true"></i></a>
    </div>
    <div class="modern-review-grid">
        {{#each recentReviews}}
        <article class="modern-review-card">
            <div class="modern-review-card__header"><img src="/uploads/{{user.avatar}}" alt=""><div><strong>@{{user.username}}</strong><span>{{establishment.name}}</span></div><div class="modern-review-card__rating"><i data-lucide="star" aria-hidden="true"></i>{{rating}}</div></div>
            <p>“{{comment}}”</p>
        </article>
        {{else}}<div class="modern-empty-state">The community is just getting started. Be the first to review a place.</div>{{/each}}
    </div>
</section>

<section class="community-cta">
    <div><p class="section-kicker">Built by the community</p><h2>Know a spot worth sharing?</h2><p>Join Tafteria and help classmates find their next favorite meal.</p></div>
    <a href="/register">Create your account <i data-lucide="arrow-right" aria-hidden="true"></i></a>
</section>

<script src="/js/establishment-images-from-geo-api.js"></script>
<script src="/js/home-animations.js"></script>
