<header class="site-header">
    <div class="site-header__inner">
        <a href="/" class="site-brand" aria-label="Tafteria home">
            <img src="/images/tafteria-logo.png" alt="Tafteria" class="site-brand-logo">
        </a>
        <nav class="site-desktop-nav" aria-label="Primary navigation">
            <a href="/establishments">Explore</a>
            <a href="/establishments?rating=4.5">Top rated</a>
        </nav>
        <form action="/search" method="GET" class="site-search-form">
            <label class="sr-only" for="site-search-q">Search establishments or reviews</label>
            <i data-lucide="search" aria-hidden="true"></i>
            <input id="site-search-q" type="search" name="q" autocomplete="off" placeholder="Search Taft food spots">
        </form>
        <div class="site-header__actions">
            <a class="site-action site-action--quiet" href="/register">Join</a>
            <a class="site-action site-action--primary" href="/login">Log in</a>
        </div>
    </div>
</header>
