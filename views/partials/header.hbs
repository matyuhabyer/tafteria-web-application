<!-- Header -->
<header class="site-header w-full h-16 md:h-20 flex items-center justify-between px-4 md:px-8 text-white shadow-md sticky top-0 z-30 bg-green-900 bg-opacity-95 backdrop-blur-md border-b border-white border-opacity-10">
    <div class="flex items-center min-w-0 flex-shrink-0">
        <a href="/" class="flex items-center group">
            <img class="h-44 md:h-48 w-auto transition-transform group-hover:scale-[1.02]" alt="Tafteria" src="/images/tafteria-logo.png">
        </a>
    </div>
    <div class="flex-grow max-w-lg mx-2 md:mx-8 min-w-0">
        <form action="/search" method="GET" class="flex rounded-full shadow-inner overflow-hidden border border-white border-opacity-20 bg-white bg-opacity-95 focus-within:ring-2 focus-within:ring-yellow-400 focus-within:ring-opacity-70 transition-shadow">
            <label class="sr-only" for="site-search-q">Search establishments or reviews</label>
            <input id="site-search-q" type="search" name="q" autocomplete="off" class="w-full h-10 md:h-11 px-4 text-gray-900 placeholder-gray-500 bg-transparent focus:outline-none text-sm md:text-base" placeholder="Search places or reviews…">
            <button type="submit" class="h-10 md:h-11 px-4 md:px-6 bg-yellow-600 text-white font-semibold text-sm md:text-base hover:bg-yellow-500 transition-colors whitespace-nowrap inline-flex items-center justify-center gap-2">
                <i data-lucide="search" class="w-4 h-4 md:w-5 md:h-5 flex-shrink-0" aria-hidden="true"></i>
                Search
            </button>
        </form>
    </div>
    <div class="flex items-center space-x-2 md:space-x-3 flex-shrink-0">
        <a class="inline-flex items-center px-3 py-1.5 md:px-4 md:py-2 rounded-full font-semibold text-xs md:text-sm text-white border-2 border-yellow-500 border-opacity-90 hover:bg-white hover:text-yellow-800 transition-colors" href="/register">Register</a>
        <a class="inline-flex items-center px-3 py-1.5 md:px-4 md:py-2 rounded-full font-semibold text-xs md:text-sm bg-yellow-500 text-white hover:bg-yellow-400 transition-colors shadow-sm" href="/login">Log in</a>
    </div>
</header>
