<header class="site-header">
    <div class="site-header__inner">
        <a href="/" class="site-brand" aria-label="Tafteria home">
            <img src="/images/tafteria-logo.png" alt="Tafteria" class="site-brand-logo">
        </a>
        <nav class="site-desktop-nav" aria-label="Primary navigation">
            <a href="/establishments">Explore</a>
            <a href="/establishments?rating=4.5">Top rated</a>
        </nav>
        <form action="/search" method="GET" class="site-search-form">
            <label class="sr-only" for="site-search-q-user">Search establishments or reviews</label>
            <i data-lucide="search" aria-hidden="true"></i>
            <input id="site-search-q-user" type="search" name="q" autocomplete="off" placeholder="Search Taft food spots">
        </form>
        <div class="site-header__actions">
            <a href="/profile" class="site-profile-link" aria-label="Open profile">
                {{#if user.avatar}}
                <img src="/uploads/{{user.avatar}}" alt="">
                {{else}}
                <i data-lucide="user" aria-hidden="true"></i>
                {{/if}}
                <span>{{user.username}}</span>
            </a>
            <div class="site-menu" data-site-menu>
                <button type="button" id="site-menu-button" class="site-icon-button site-header__menu-button" aria-label="Open menu" aria-haspopup="menu" aria-controls="site-menu-dropdown" aria-expanded="false">
                    <i data-lucide="menu" aria-hidden="true"></i>
                </button>
                <nav id="site-menu-dropdown" class="site-menu-dropdown" role="menu" aria-label="Account navigation" aria-labelledby="site-menu-button" hidden>
                    <div class="site-menu-dropdown__account">
                        <span>Signed in as</span>
                        <strong>{{user.username}}</strong>
                    </div>
                    <a href="/" role="menuitem"><i data-lucide="house" aria-hidden="true"></i>Home</a>
                    <a href="/profile" role="menuitem"><i data-lucide="user-round" aria-hidden="true"></i>Profile</a>
                    <a href="/establishments" role="menuitem"><i data-lucide="map-pinned" aria-hidden="true"></i>Establishments</a>
                    <div class="site-menu-dropdown__divider"></div>
                    <a href="/logout" role="menuitem" class="site-menu-dropdown__logout"><i data-lucide="log-out" aria-hidden="true"></i>Log out</a>
                </nav>
            </div>
        </div>
    </div>
</header>
