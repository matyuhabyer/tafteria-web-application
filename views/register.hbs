<div class="auth-page">
    <section class="auth-card auth-card--wide" aria-labelledby="register-title">
        <div class="auth-card__header">
            <p class="auth-eyebrow">Join the map</p>
            <h1 id="register-title" class="auth-title">Create your Tafteria account</h1>
            <p class="auth-subtitle">Add your profile, rate campus eats, and help the next hungry person choose well.</p>
        </div>

        <form action="/register" method="POST" enctype="multipart/form-data" class="auth-form">
            <div class="form-field">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" autocomplete="username" required>
            </div>
            <div class="form-field">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" autocomplete="new-password" required>
            </div>
            <div class="form-field">
                <label for="avatar">Avatar</label>
                <input type="file" id="avatar" name="avatar" accept="image/*" required>
            </div>
            <div class="form-field">
                <label for="description">Short description <span>Optional</span></label>
                <textarea id="description" name="description" rows="3" placeholder="Tell people what kind of food you usually look for."></textarea>
            </div>
            <button type="submit" class="btn-modern btn-modern--primary">Create account</button>
            <p class="auth-switch">
                Already have an account?
                <a href="/login">Log in</a>
            </p>
        </form>
    </section>
</div>
